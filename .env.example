# モデル名（models/ディレクトリ配下のモデル名を指定）
MODEL_NAME=gemma-3-4b-it

# データセットのパス（load_datasetで読み込むJSONLファイルのパス）
DATASET_PATH=data/help_list_tool_login.jsonl

# 学習後の最終テスト評価をスキップするかどうか（true/false、デフォルトはfalse）
SKIP_FINAL_TEST=false

# LoRAアダプターのディレクトリパス（merge_lora_mps.pyで使用）
ADAPTER_DIR=models/gemma-2-9b-lora-20251030-182416
